NODE_ENV=development
PERSISTENCE_MODE=memory
# Propuesta demo: 8 creditos = 2 horas; aprobacion definitiva del PO pendiente.
REGISTRATION_INITIAL_CREDITS=8
PORT=4000
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
# Generar localmente con npm run setup:env. Nunca subir .env.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=banco-tiempo-backend
JWT_AUDIENCE=banco-tiempo-clients
# setup:docker configura la URL local. Compose usa postgres:5432 internamente.
DATABASE_URL=
DATABASE_ENABLED=false
SWAGGER_ENABLED=true
# Google Calendar: mantener los valores reales solo en .env y en variables privadas de Render.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/calendar/callback
FRONTEND_URL=http://localhost:5173
# PostgreSQL local de Compose; setup:docker genera la clave sin publicarla.
POSTGRES_USER=timebank
POSTGRES_DB=timebank_local
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Solo la inicializacion local de Compose activa la semilla.
LOCAL_DEVELOPMENT_SEED=false
