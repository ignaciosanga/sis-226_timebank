NODE_ENV=development
PERSISTENCE_MODE=memory
PORT=4000
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
# Generar localmente con npm run setup:env. Nunca subir .env.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=banco-tiempo-backend
JWT_AUDIENCE=banco-tiempo-clients
# setup:docker configura la URL local. Compose usa postgres:5432 internamente.
DATABASE_URL=
DATABASE_ENABLED=false
SWAGGER_ENABLED=true
# PostgreSQL local de Compose; setup:docker genera la clave sin publicarla.
POSTGRES_USER=timebank
POSTGRES_DB=timebank_local
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Solo la inicializacion local de Compose activa la semilla.
LOCAL_DEVELOPMENT_SEED=false
