{
  "info": {
    "name": "Nexo U - HU-01 y HU-05 (Camila)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Antes de correr: abre /health/ready del backend (Render se duerme). En Variables (columna Current value) escribe correo, password, adminCorreo y adminPassword. Para admin, usa la carpeta HU-05. IMPORTANTE: las credenciales NO estan guardadas en el archivo; escribelas solo en tu Postman y no exportes la coleccion con ellas."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://timebank-backend-51q9.onrender.com"
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "adminCorreo",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "idCarrera",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "HU-01 Estudiante",
      "item": [
        {
          "name": "1. GET /careers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/careers?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "careers"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('hay carreras', () => pm.expect(d.data.length).to.be.above(0));",
                  "pm.collectionVariables.set('idCarrera', d.data[0].id_carrera || d.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba\",\n  \"apellido\": \"Cami\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\",\n  \"idCarrera\": \"{{idCarrera}}\",\n  \"semestre\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 o 409 si ya existe', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('trae access_token', () => pm.expect(d.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', d.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. GET /users/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('correo coincide', () => pm.expect(pm.response.json().correo).to.eql(pm.collectionVariables.get('correo')));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. PATCH /users/me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cami\",\n  \"apellido\": \"Prueba\",\n  \"semestre\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('semestre actualizado', () => pm.expect(pm.response.json().semestre).to.eql(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. GET /users/me sin token (debe dar 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
