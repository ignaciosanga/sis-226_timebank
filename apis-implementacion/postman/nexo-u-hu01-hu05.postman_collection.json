                  "const d = pm.response.json();",
                  "pm.test('trae access_token', () => pm.expect(d.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', d.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET /admin/users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "6"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('trae data y meta', () => { pm.expect(d.data).to.be.an('array'); pm.expect(d.meta.total).to.be.a('number'); });",
                  "const est = d.data.find(u => u.rol === 'Estudiante'); if (est) pm.collectionVariables.set('userId', est.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. POST /admin/users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alta\",\n  \"apellido\": \"Admin\",\n  \"correo\": \"alta.{{$timestamp}}@ucb.edu.bo\",\n  \"password\": \"{{password}}\",\n  \"idCarrera\": \"{{idCarrera}}\",\n  \"semestre\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
