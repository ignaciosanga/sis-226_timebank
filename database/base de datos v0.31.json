{ "nombre": "Sistema de intercambio de habilidades", "version": "0.31", "motor": "PostgreSQL", "tablas": { "CARRERAS": { "campos": { "id_carrera": { "tipo": "uuid", "pk": true }, "nombre": { "tipo": "varchar" }, "facultad": { "tipo": "varchar" }, "estado": { "tipo": "varchar" } } }, "CATEGORIAS": { "campos": { "id_categoria": { "tipo": "uuid", "pk": true }, "nombre": { "tipo": "varchar", "unique": true }, "estado": { "tipo": "varchar" } } }, "USUARIOS": { "campos": { "id_usuario": { "tipo": "uuid", "pk": true }, "nombre": { "tipo": "varchar" }, "apellido": { "tipo": "varchar" }, "correo": { "tipo": "varchar", "unique": true }, "password_hash": { "tipo": "varchar" }, "id_carrera": { "tipo": "uuid", "fk": "CARRERAS.id_carrera" }, "semestre": { "tipo": "int", "version": "0.3" }, "fecha_registro": { "tipo": "timestamptz", "default": "now()" }, "ultimo_acceso": { "tipo": "timestamptz" }, "estado": { "tipo": "varchar" } } }, "ROLES": { "campos": { "id_rol": { "tipo": "uuid", "pk": true }, "nombre": { "tipo": "varchar", "unique": true } } }, "USUARIO_ROLES": { "campos": { "id_usuario": { "tipo": "uuid", "pk": true, "fk": "USUARIOS.id_usuario" }, "id_rol": { "tipo": "uuid", "pk": true, "fk": "ROLES.id_rol" } } }, "HABILIDADES": { "campos": { "id_habilidad": { "tipo": "uuid", "pk": true }, "nombre": { "tipo": "varchar", "unique": true }, "id_categoria": { "tipo": "uuid", "fk": "CATEGORIAS.id_categoria" }, "estado": { "tipo": "varchar" } } }, "USUARIO_HABILIDADES": { "campos": { "id_usuario": { "tipo": "uuid", "pk": true, "fk": "USUARIOS.id_usuario" }, "id_habilidad": { "tipo": "uuid", "pk": true, "fk": "HABILIDADES.id_habilidad" }, "nivel": { "tipo": "varchar" } } }, "DISPONIBILIDADES": { "campos": { "id_disponibilidad": { "tipo": "uuid", "pk": true }, "id_usuario": { "tipo": "uuid", "fk": "USUARIOS.id_usuario" }, "fecha_inicio": { "tipo": "timestamptz" }, "fecha_fin": { "tipo": "timestamptz" }, "estado": { "tipo": "varchar" } } }, "SOLICITUDES_INTERCAMBIO": { "campos": { "i