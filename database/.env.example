# Copia este archivo como .env y cambia los valores.
# El .env es personal: NUNCA se sube a GitHub (.gitignore lo excluye).

POSTGRES_DB=banco_tiempo
POSTGRES_USER=banco_owner
POSTGRES_PASSWORD=cambia_esta_clave

# Clave de cifrado (32 caracteres o más). Genera una con:
#   Mac / Linux:  openssl rand -base64 36
#   Windows:      [Convert]::ToBase64String((1..36 | % {Get-Random -Max 256}))
# Si la pierdes, los datos cifrados NO se pueden recuperar.
# Todos los que compartan una misma base deben usar la misma clave.
APP_ENCRYPTION_KEY=cambia_esta_clave_de_cifrado_por_una_de_32_o_mas

# 127.0.0.1 -> solo esta computadora (recomendado)
DB_BIND=127.0.0.1
# 15434 para no chocar con otro PostgreSQL ni con las otras versiones en Docker
DB_PORT=15434
