# Copiar a .env y reemplazar TODOS los valores de ejemplo.
POSTGRES_DB=skillswap
POSTGRES_USER=skillswap_admin
POSTGRES_PASSWORD=CAMBIAR_POR_UN_SECRETO_ADMIN_LARGO
POSTGRES_PORT=5432

APP_DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_APP_LARGO
LECTURA_DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LECTURA_LARGO

# Generar cada clave por separado: openssl rand -hex 32
APP_ENCRYPTION_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_HEX
APP_HASH_PEPPER=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_64_HEX
